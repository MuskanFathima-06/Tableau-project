      <aliases enabled='yes' />
      <column caption='Additional Info' datatype='string' name='[Additional_Info]' role='dimension' type='nominal' />
      <column datatype='string' name='[Airline]' role='dimension' type='nominal' />
      <column caption='Arrival Time' datatype='string' name='[Arrival_Time]' role='dimension' type='nominal' />
      <column caption='Flight Count' datatype='integer' name='[Calculation_0124298053791744]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Duration Total Minutes' datatype='integer' name='[Calculation_0438758302457856]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_0666631808684036] * 60) + [Calculation_0666631807938563]' />
      </column>
      <column caption='Duration Total Hours' datatype='real' name='[Calculation_0438758302638081]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0438758302457856] / 60.0' />
      </column>
      <column caption='Price per Hour' datatype='real' name='[Calculation_0438758302953474]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_0438758302638081] &gt; 0 THEN&#13;&#10;    [Price] / [Calculation_0438758302638081]&#13;&#10;ELSE&#13;&#10;    NULL&#13;&#10;END' />
      </column>
      <column caption='Departure Hour' datatype='integer' name='[Calculation_0438758303993859]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT(SPLIT(TRIM([Dep_Time]), &quot;:&quot;, 1))' />
      </column>
      <column caption='Departure Time of Day' datatype='string' name='[Calculation_0438758304116740]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0438758303993859] &lt; 5 THEN &quot;Night&quot;&#13;&#10;ELSEIF [Calculation_0438758303993859] &lt; 12 THEN &quot;Morning&quot;&#13;&#10;ELSEIF [Calculation_0438758303993859] &lt; 17 THEN &quot;Afternoon&quot;&#13;&#10;ELSEIF [Calculation_0438758303993859] &lt; 21 THEN &quot;Evening&quot;&#13;&#10;ELSE &quot;Night&quot;&#13;&#10;END' />
      </column>
      <column caption='Journey Date' datatype='date' name='[Calculation_0666631806455810]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(&#13;&#10;    DATEPARSE(&quot;dd/MM/yyyy&quot;, [Date_of_Journey])&#13;&#10;)' />
      </column>
      <column caption='Duration Minutes Part' datatype='integer' name='[Calculation_0666631807938563]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF CONTAINS([Duration], &quot;m&quot;) THEN&#13;&#10;    INT(TRIM(REPLACE(SPLIT([Duration], &quot;h&quot;, 2), &quot;m&quot;, &quot;&quot;)))&#13;&#10;ELSE&#13;&#10;    0&#13;&#10;END' />
      </column>
      <column caption='Duration Hours' datatype='integer' name='[Calculation_0666631808684036]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF CONTAINS([Duration], &quot;h&quot;) THEN&#13;&#10;    INT(TRIM(SPLIT([Duration], &quot;h&quot;, 1)))&#13;&#10;ELSE&#13;&#10;    0&#13;&#10;END' />
      </column>
      <column caption=' Price per Hour' datatype='real' name='[Calculation_0666631808831493]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Price] / [Calculation_0666631808684036]' />
      </column>
      <column caption='Number of Stops' datatype='integer' name='[Calculation_0666631809024006]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Total_Stops] = &quot;non-stop&quot; THEN 0&#13;&#10;ELSEIF [Total_Stops] = &quot;1 stop&quot; THEN 1&#13;&#10;ELSEIF [Total_Stops] = &quot;2 stops&quot; THEN 2&#13;&#10;ELSEIF [Total_Stops] = &quot;3 stops&quot; THEN 3&#13;&#10;ELSEIF [Total_Stops] = &quot;4 stops&quot; THEN 4&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
      <column caption=' Non-stop Flight' datatype='string' name='[Calculation_0666631809171463]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Total_Stops] = &quot;non-stop&quot; THEN &quot;Yes&quot;&#13;&#10;ELSE &quot;No&quot;&#13;&#10;END' />
      </column>
      <column caption='Route Label' datatype='string' name='[Calculation_0666631824257047]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Source] + &quot; → &quot; + [Destination]' />
      </column>
      <column caption='Date of Journey' datatype='string' name='[Date_of_Journey]' role='dimension' type='nominal' />
      <column caption='Dep Time' datatype='string' name='[Dep_Time]' role='dimension' type='nominal' />
      <column datatype='string' name='[Destination]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
