    <worksheet name=' Duration versus price'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>Price By Duration</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='data_train (Data_Train_fortableau)' name='federated.1x6pau510chtqu1g08iba1uozoer' />
          </datasources>
          <datasource-dependencies datasource='federated.1x6pau510chtqu1g08iba1uozoer'>
            <column datatype='string' name='[Airline]' role='dimension' type='nominal' />
            <column caption='Duration Total Minutes' datatype='integer' name='[Calculation_0438758302457856]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_0666631808684036] * 60) + [Calculation_0666631807938563]' />
            </column>
            <column caption='Journey Date' datatype='date' name='[Calculation_0666631806455810]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(&#13;&#10;    DATEPARSE(&quot;dd/MM/yyyy&quot;, [Date_of_Journey])&#13;&#10;)' />
            </column>
            <column caption='Duration Minutes Part' datatype='integer' name='[Calculation_0666631807938563]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF CONTAINS([Duration], &quot;m&quot;) THEN&#13;&#10;    INT(TRIM(REPLACE(SPLIT([Duration], &quot;h&quot;, 2), &quot;m&quot;, &quot;&quot;)))&#13;&#10;ELSE&#13;&#10;    0&#13;&#10;END' />
            </column>
            <column caption='Duration Hours' datatype='integer' name='[Calculation_0666631808684036]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF CONTAINS([Duration], &quot;h&quot;) THEN&#13;&#10;    INT(TRIM(SPLIT([Duration], &quot;h&quot;, 1)))&#13;&#10;ELSE&#13;&#10;    0&#13;&#10;END' />
            </column>
            <column caption=' Non-stop Flight' datatype='string' name='[Calculation_0666631809171463]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Total_Stops] = &quot;non-stop&quot; THEN &quot;Yes&quot;&#13;&#10;ELSE &quot;No&quot;&#13;&#10;END' />
            </column>
            <column caption='Route Label' datatype='string' name='[Calculation_0666631824257047]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Source] + &quot; → &quot; + [Destination]' />
            </column>
